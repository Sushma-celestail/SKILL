        "architecture_decisions": [
            {
                "id": "ADR-001",
                "decision": "Centralised RBAC via CMP-008",
                "context": "8 modules all require access control",
                "reason": "Single enforcement point reduces risk of inconsistent access decisions across modules",
                "alternative": "Per-module access checks",
                "why_not_alternative": "Inconsistent enforcement and duplicated logic",
                "trade_offs": "CMP-008 becomes a dependency for all modules",
                "impact": "All API handlers call CMP-008 before processing",
                "status": "accepted",
                "related_requirements": [
                    "REQ-008",
                    "REQ-012"
                ]
            },
            {
                "id": "ADR-002",
                "decision": "Migration is a separate one-time module (MOD-008)",
                "context": "Legacy ITSM data must be migrated before go-live",
                "reason": "Migration is separate from ongoing integration; isolating it prevents production code from carrying migration logic",
                "alternative": "Inline migration during application startup",
                "why_not_alternative": "Risk of production corruption; violates §25 migration separation principle",
                "trade_offs": "Requires a dedicated migration run before go-live",
                "impact": "MOD-008 is decommissioned after successful migration",
                "status": "accepted",
                "related_requirements": [
                    "REQ-007"
                ]
            }
